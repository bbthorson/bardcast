{
  "name": "bardcast",
  "version": "0.0.0",
  "private": true,
  "description": "Turn a group of friends into characters in an ongoing RPG actual-play podcast, generated from their own audio replies. Built on Antiphony.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "lint:lore": "pinakes lint --root content/campaigns/sir-gawain-and-the-green-knight",
    "compile:lore": "pinakes compile --root content/campaigns/sir-gawain-and-the-green-knight",
    "prose:lore": "pinakes prose-check --root content/campaigns/sir-gawain-and-the-green-knight",
    "dev:orchestrator": "npm run dev -w @bardcast/orchestrator",
    "dev:player": "npm run dev -w @bardcast/player",
    "dev:dm": "npm run dev -w @bardcast/dm",
    "dev:web": "npm run dev -w @bardcast/web"
  },
  "devDependencies": {
    "@bbthorson/pinakes": "1.0.2",
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "^8.3.8",
    "wrangler": "4.166.0"
  },
  "engines": {
    "node": ">=26"
  },
  "volta": {
    "node": "26.13.1"
  }
}
