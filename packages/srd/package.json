{
  "name": "@bardcast/srd",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A typed subset of the D&D System Reference Document 5.2 (CC-BY-4.0): classes, species, backgrounds, feats, equipment, skills and conditions. Generated from a pinned 5e-bits commit; see NOTICE.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./source": "./src/source.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "import": "tsx scripts/import.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "sideEffects": false
}
