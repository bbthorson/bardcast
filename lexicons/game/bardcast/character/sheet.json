{
    "lexicon": 1,
    "id": "game.bardcast.character.sheet",
    "defs": {
        "main": {
            "type": "record",
            "description": "One version of a character's sheet, owned by the player: a D&D SRD 5.2 (CC-BY-4.0) backbone under a narrative face. Lives in the player's own repo and travels with them. IMMUTABLE: a version is never edited. Every change is a new record whose `prev` points at the version it replaces, like a reply pointing at its parent, and the character.profile's `sheet` ref names the current one. Two versions sharing a `prev` are a fork. Stored as level-1 choices plus an advancement log, so it can be replayed to any lower level when it joins a campaign. Campaigns never write one; they branch a game.bardcast.campaign.seat from it.",
            "key": "tid",
            "record": {
                "type": "object",
                "required": [
                    "character",
                    "class",
                    "abilities",
                    "createdAt"
                ],
                "properties": {
                    "character": {
                        "type": "string",
                        "format": "at-uri",
                        "description": "AT-URI of the character.profile this sheet belongs to."
                    },
                    "class": {
                        "type": "string",
                        "knownValues": [
                            "barbarian",
                            "bard",
                            "cleric",
                            "druid",
                            "fighter",
                            "monk",
                            "paladin",
                            "ranger",
                            "rogue",
                            "sorcerer",
                            "warlock",
                            "wizard"
                        ],
                        "description": "SRD 5.2 class."
                    },
                    "species": {
                        "type": "string",
                        "maxLength": 60
                    },
                    "background": {
                        "type": "string",
                        "maxLength": 60
                    },
                    "abilities": {
                        "type": "ref",
                        "ref": "#abilityScores",
                        "description": "Level-1 ability scores, after the background's increases (SRD 5.2). Later increases live in `advancements`."
                    },
                    "features": {
                        "type": "array",
                        "maxLength": 32,
                        "items": {
                            "type": "string",
                            "maxLength": 120
                        },
                        "description": "Level-1 features."
                    },
                    "advancements": {
                        "type": "array",
                        "maxLength": 19,
                        "items": {
                            "type": "ref",
                            "ref": "#advancement"
                        },
                        "description": "Levels 2..n in order, no gaps. The sheet's level is 1 + this length."
                    },
                    "traits": {
                        "type": "array",
                        "maxLength": 32,
                        "items": {
                            "type": "ref",
                            "ref": "#trait"
                        },
                        "description": "Personality, from Bardcast's closed trait vocabulary."
                    },
                    "quirks": {
                        "type": "array",
                        "maxLength": 8,
                        "items": {
                            "type": "string",
                            "maxLength": 200
                        },
                        "description": "Free-text quirks: the narrative face a player reads first."
                    },
                    "equipment": {
                        "type": "array",
                        "maxLength": 64,
                        "items": {
                            "type": "ref",
                            "ref": "#item"
                        },
                        "description": "Permanent equipment. A campaign's gear policy decides whether it comes to the table."
                    },
                    "prev": {
                        "type": "ref",
                        "ref": "com.atproto.repo.strongRef",
                        "description": "The version this one replaces. Absent on a character's first sheet."
                    },
                    "fromSeat": {
                        "type": "string",
                        "format": "at-uri",
                        "description": "The campaign seat this version's levels came from, when progress was brought home."
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "datetime",
                        "description": "When this version was made."
                    }
                }
            }
        },
        "snapshot": {
            "type": "object",
            "description": "The same fields as a sheet record, for embedding: a seat keeps the sheet it was branched from as one of these. Keep in step with main.",
            "required": [
                "character",
                "class",
                "abilities",
                "createdAt"
            ],
            "properties": {
                "character": {
                    "type": "string",
                    "format": "at-uri",
                    "description": "AT-URI of the character.profile this sheet belongs to."
                },
                "class": {
                    "type": "string",
                    "knownValues": [
                        "barbarian",
                        "bard",
                        "cleric",
                        "druid",
                        "fighter",
                        "monk",
                        "paladin",
                        "ranger",
                        "rogue",
                        "sorcerer",
                        "warlock",
                        "wizard"
                    ],
                    "description": "SRD 5.2 class."
                },
                "species": {
                    "type": "string",
                    "maxLength": 60
                },
                "background": {
                    "type": "string",
                    "maxLength": 60
                },
                "abilities": {
                    "type": "ref",
                    "ref": "#abilityScores",
                    "description": "Level-1 ability scores, after the background's increases (SRD 5.2). Later increases live in `advancements`."
                },
                "features": {
                    "type": "array",
                    "maxLength": 32,
                    "items": {
                        "type": "string",
                        "maxLength": 120
                    },
                    "description": "Level-1 features."
                },
                "advancements": {
                    "type": "array",
                    "maxLength": 19,
                    "items": {
                        "type": "ref",
                        "ref": "#advancement"
                    },
                    "description": "Levels 2..n in order, no gaps. The sheet's level is 1 + this length."
                },
                "traits": {
                    "type": "array",
                    "maxLength": 32,
                    "items": {
                        "type": "ref",
                        "ref": "#trait"
                    },
                    "description": "Personality, from Bardcast's closed trait vocabulary."
                },
                "quirks": {
                    "type": "array",
                    "maxLength": 8,
                    "items": {
                        "type": "string",
                        "maxLength": 200
                    },
                    "description": "Free-text quirks: the narrative face a player reads first."
                },
                "equipment": {
                    "type": "array",
                    "maxLength": 64,
                    "items": {
                        "type": "ref",
                        "ref": "#item"
                    },
                    "description": "Permanent equipment. A campaign's gear policy decides whether it comes to the table."
                },
                "prev": {
                    "type": "ref",
                    "ref": "com.atproto.repo.strongRef",
                    "description": "The version this one replaces. Absent on a character's first sheet."
                },
                "fromSeat": {
                    "type": "string",
                    "format": "at-uri",
                    "description": "The campaign seat this version's levels came from, when progress was brought home."
                },
                "createdAt": {
                    "type": "string",
                    "format": "datetime",
                    "description": "When this version was made."
                }
            }
        },
        "abilityScores": {
            "type": "object",
            "required": [
                "strength",
                "dexterity",
                "constitution",
                "intelligence",
                "wisdom",
                "charisma"
            ],
            "properties": {
                "strength": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 30
                },
                "dexterity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 30
                },
                "constitution": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 30
                },
                "intelligence": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 30
                },
                "wisdom": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 30
                },
                "charisma": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 30
                }
            }
        },
        "advancement": {
            "type": "object",
            "description": "One level gained.",
            "required": [
                "level",
                "hitPoints",
                "createdAt"
            ],
            "properties": {
                "level": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 20
                },
                "hitPoints": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 12,
                    "description": "Hit points gained, before the Constitution modifier."
                },
                "abilityIncreases": {
                    "type": "ref",
                    "ref": "#abilityIncreases",
                    "description": "An ability-score increase taken at this level."
                },
                "feat": {
                    "type": "string",
                    "maxLength": 80
                },
                "features": {
                    "type": "array",
                    "maxLength": 16,
                    "items": {
                        "type": "string",
                        "maxLength": 120
                    }
                },
                "createdAt": {
                    "type": "string",
                    "format": "datetime"
                }
            }
        },
        "abilityIncreases": {
            "type": "object",
            "properties": {
                "strength": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2
                },
                "dexterity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2
                },
                "constitution": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2
                },
                "intelligence": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2
                },
                "wisdom": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2
                },
                "charisma": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2
                }
            }
        },
        "trait": {
            "type": "object",
            "required": [
                "name"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "maxLength": 80
                },
                "value": {
                    "type": "string",
                    "maxLength": 200
                }
            }
        },
        "item": {
            "type": "object",
            "description": "A piece of equipment, on a player's sheet or a campaign seat.",
            "required": [
                "id",
                "name",
                "kind",
                "source"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "maxLength": 64,
                    "description": "Stable within one sheet or seat, so an action can lose, upgrade or equip this item."
                },
                "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                },
                "kind": {
                    "type": "string",
                    "knownValues": [
                        "weapon",
                        "armor",
                        "shield",
                        "gear"
                    ]
                },
                "srd": {
                    "type": "string",
                    "maxLength": 80,
                    "description": "The SRD 5.2 equipment entry, when there is one (e.g. 'longsword'). AC and attacks are computed from it."
                },
                "bonus": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3,
                    "description": "A magic +1 to +3."
                },
                "equipped": {
                    "type": "boolean"
                },
                "source": {
                    "type": "string",
                    "knownValues": [
                        "start",
                        "brought",
                        "found",
                        "bought",
                        "given"
                    ],
                    "description": "Where it came from at the table. start: the table's starting kit. brought: the player's own equipment."
                },
                "note": {
                    "type": "string",
                    "maxLength": 300
                }
            }
        }
    }
}
