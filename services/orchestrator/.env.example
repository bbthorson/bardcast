# Orchestrator config (copy to .env for local dev)
PORT=8787

# This service's own public URL — roots the AT-Proto client_id + redirect_uri.
ORCHESTRATOR_BASE_URL=http://localhost:8787

# Identity: "stub" (dev, x-bardcast-did header) or "atproto" (real OAuth).
AUTH_MODE=stub
APP_NAME=Bardcast

# Base URL of the Antiphony Core API deployment.
VOXPOP_BASE_URL=http://localhost:8080
# Bardcast's app service token — the ONLY credential Antiphony accepts. Register
# Bardcast as an app in Antiphony's ANTIPHONY_APP_TOKENS (appId:token); the token
# establishes tenancy (originAppId). The acting player's DID is asserted per
# write via the X-Antiphony-Acting-Actor(-Did) headers, not a per-player token.
# VOXPOP_SERVICE_TOKEN=

# Where the player PWA is served (engagement deep links + post-login redirect).
APP_BASE_URL=http://localhost:5173
